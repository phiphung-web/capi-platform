generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  RETRYING
  DEAD
}

model Project {
  id            String        @id @default(cuid())
  name          String
  description   String?
  domain        String?
  autoFixLevel  String        @default("safe_defaults")
  createdAt     DateTime      @default(now())
  apiKeys       ApiKey[]
  destinations  Destination[]
  events        Event[]
  sources       Source[]
  members       ProjectMember[]
  stages        StageDefinition[]
}

model ApiKey {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  name      String
  key       String   @unique
  prefix    String
  isActive  Boolean  @default(true)
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
}

model Destination {
  id            String         @id @default(cuid())
  project       Project        @relation(fields: [projectId], references: [id])
  projectId     String
  type          String
  adapterKey    String
  config        Json           @default("{}")
  isActive      Boolean        @default(true)
  isEnabled     Boolean        @default(true)
  healthStatus  String         @default("UNKNOWN")
  rulesetVersion Int           @default(1)
  deliveryPolicy Json          @default("{\"maxAttempts\":8,\"baseBackoffSeconds\":5,\"maxBackoffSeconds\":3600,\"jitterRatio\":0.2}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deliveryLogs  DeliveryLog[]
  rules         DestinationRule[]
}

model Event {
  id            String         @id @default(cuid())
  project       Project        @relation(fields: [projectId], references: [id])
  projectId     String
  source        Source?        @relation(fields: [sourceId], references: [id])
  sourceId      String?
  eventName     String
  eventId       String
  eventTime     Int
  stage         String?
  occurredAt    DateTime?
  receivedAt    DateTime       @default(now())
  clientEventId String?
  dedupeKey     String
  schemaVersion Int            @default(1)
  actorEmail     String?
  actorPhone     String?
  actorExternalId String?
  actorIp        String?
  actorUserAgent String?
  objectType     String?
  objectId       String?
  valueAmount    Decimal?
  valueCurrency  String?
  sourceTag     String         @default("unknown")
  userJson      Json
  dataJson      Json
  rawPayload    Json?
  qualityScore  Int            @default(0)
  qualityFlags  Json?
  createdAt     DateTime       @default(now())
  deliveryLogs  DeliveryLog[]

  @@unique([projectId, dedupeKey])
  @@index([projectId, occurredAt])
  @@index([projectId, stage])
  @@index([projectId, eventName])
}

model DeliveryLog {
  id            String       @id @default(cuid())
  event         Event        @relation(fields: [eventId], references: [id])
  eventId       String
  destination   Destination  @relation(fields: [destinationId], references: [id])
  destinationId String
  status        DeliveryStatus @default(PENDING)
  attemptCount  Int            @default(0)
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?
  lastError     String?
  providerStatusCode Int?
  providerResponse Json?
  processingLockId String?
  processingLockedAt DateTime?
  deliveredAt   DateTime?
  adapterKey    String
  destinationRule DestinationRule? @relation(fields: [destinationRuleId], references: [id])
  destinationRuleId String?
  providerEventName String?
  providerRequest Json?
  uniqueDeliveryKey String @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt])
  @@index([destinationId, status])
  @@index([eventId])
}

model Source {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  name        String
  eventKey    String   @unique
  type        String?
  mappingJson Json?
  seenFields  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      Event[]
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  role           String           @default("OPERATOR")
  passwordHash   String
  isActive       Boolean          @default(true)
  projectMembers ProjectMember[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProjectMember {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  projectRole String   @default("OPERATOR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, projectId])
}

model DestinationRule {
  id            String      @id @default(cuid())
  destination   Destination @relation(fields: [destinationId], references: [id])
  destinationId String
  name          String
  isEnabled     Boolean     @default(true)
  priority      Int         @default(100)
  match         Json
  action        Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  deliveryLogs  DeliveryLog[]

  @@unique([destinationId, name])
  @@index([destinationId, isEnabled, priority])
}

model StageDefinition {
  id            String   @id @default(cuid())
  project       Project  @relation(fields: [projectId], references: [id])
  projectId     String
  key           String
  displayName   String
  description   String?
  order         Int      @default(0)
  isDefault     Boolean  @default(false)
  inferenceRules Json    @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId, key])
}
